<?xml version="1.0" encoding="utf-8"?>
<!-- Tablet: o logótipo FinsaFix, contexto e título; à direita a paragem ativa, "Guardado neste tablet", hora e avatar com nome e turno. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraTopo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/if_topbar_height"
        android:background="?attr/colorSurface"
        android:theme="@style/ThemeOverlay.FinsaFix.BarraTopo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.FinsaFix.Logo.Pequeno" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:minWidth="120dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textoContexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Secondary"
                    android:textColor="@color/if_on_surface_variant" />

                <TextView
                    android:id="@+id/textoTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.FinsaFix.TopBar"
                    android:textColor="@color/if_on_surface" />
            </LinearLayout>

            <include
                android:id="@+id/chipParagem"
                layout="@layout/view_paragem_ativa" />

            <TextView
                android:id="@+id/textoGuardado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_cloud_done"
                android:drawablePadding="6dp"
                android:drawableTint="@color/if_ok_text"
                android:gravity="center_vertical"
                android:text="@string/barra_guardado"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.FinsaFix.Badge"
                android:textColor="@color/if_on_surface_variant" />

            <TextClock
                android:id="@+id/relogio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textAppearance="@style/TextAppearance.FinsaFix.Title"
                android:textColor="@color/if_on_surface" />

            <TextView
                android:id="@+id/textoIniciais"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/fundo_avatar"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.FinsaFix.Label"
                android:textColor="@color/if_on_surface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textoNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Label"
                    android:textColor="@color/if_on_surface" />

                <TextView
                    android:id="@+id/textoTurnoPessoa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Badge"
                    android:textColor="@color/if_on_surface_variant" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>
</LinearLayout>
