<?xml version="1.0" encoding="utf-8"?>
<!-- O mesmo layout serve telemóvel e tablet (as linhas de avaria já se ajustam à largura). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_ecra">

        <!-- Por fazer: preventivas vencidas, peças abaixo do mínimo e parâmetros fora do limite -->
        <LinearLayout
            android:id="@+id/seccaoPorFazer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/if_section_gap"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/FinsaFix.TituloSeccao"
                android:text="@string/por_fazer" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listaPorFazer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Em progresso · para retomar (só aparece se houver) -->
        <LinearLayout
            android:id="@+id/seccaoEmProgresso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/if_section_gap"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/tecnico_em_progresso"
                android:textAppearance="@style/TextAppearance.FinsaFix.Title"
                android:textColor="@color/if_on_surface" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/listaEmProgresso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/textoTituloLista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tecnico_por_prioridade"
            android:textAppearance="@style/TextAppearance.FinsaFix.Title"
            android:textColor="@color/if_on_surface" />

        <!-- Filtros: oficina e estado -->
        <LinearLayout
            android:id="@+id/filtros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsOficina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedChip="@id/chipMinhaOficina"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMinhaOficina"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_minha_oficina"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Label" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTodasOficinas"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_todas_oficinas"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Label" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedChip="@id/chipTodasAbertas"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPendentes"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_pendentes"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Label" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEmCurso"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_em_curso"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Label" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTodasAbertas"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_todas_abertas"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Label" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listaAvarias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <TextView
                    android:id="@+id/textoSemAvarias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/if_card_padding"
                    android:text="@string/inicio_sem_avarias"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Body"
                    android:textColor="@color/if_on_surface_variant"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Minhas: “Ver avarias pendentes” quando não há intervenção em curso, e as concluídas -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoVerPendentes"
            style="@style/Widget.FinsaFix.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_item_gap"
            android:text="@string/tecnico_ver_pendentes"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/seccaoConcluidas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_section_gap"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/FinsaFix.TituloSeccao"
                android:text="@string/tecnico_concluidas" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listaConcluidas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textoSemConcluidas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tecnico_sem_concluidas"
                android:textAppearance="@style/TextAppearance.FinsaFix.Body"
                android:textColor="@color/if_on_surface_variant"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
