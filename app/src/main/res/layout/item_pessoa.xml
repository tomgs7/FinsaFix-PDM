<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/if_checklist_row_min"
    android:orientation="horizontal"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/textoIniciais"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/fundo_avatar"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.FinsaFix.Title"
        android:textColor="@color/if_on_secondary_container" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textoNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FinsaFix.Title"
            android:textColor="@color/if_on_surface" />

        <TextView
            android:id="@+id/textoFuncao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body"
            android:textColor="@color/if_on_surface_variant" />
    </LinearLayout>

    <TextView
        android:id="@+id/textoTurnoAtual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/fundo_etiqueta_tonal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="@string/entrada_turno_atual_etiqueta"
        android:textAppearance="@style/TextAppearance.FinsaFix.Secondary"
        android:textColor="@color/if_on_secondary_container" />

    <ImageView
        android:layout_width="@dimen/if_icon"
        android:layout_height="@dimen/if_icon"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chev"
        app:tint="@color/if_on_surface_variant" />
</LinearLayout>
