<?xml version="1.0" encoding="utf-8"?>
<!-- Só no ecrã do chefe de secção: “Por tratar” e os operadores do turno. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/if_section_gap"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        style="@style/FinsaFix.TituloSeccao"
        android:text="@string/por_tratar" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaPorTratar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <TextView
                android:id="@+id/textoNadaPorTratar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/if_card_padding"
                android:text="@string/por_tratar_nada"
                android:textAppearance="@style/TextAppearance.FinsaFix.Body"
                android:textColor="@color/if_ok_text"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tituloOperadores"
        style="@style/FinsaFix.TituloSeccao"
        android:layout_marginTop="@dimen/if_section_gap" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textoOperadores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:padding="@dimen/if_card_padding"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body"
            android:textColor="@color/if_on_surface" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
