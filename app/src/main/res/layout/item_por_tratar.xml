<?xml version="1.0" encoding="utf-8"?>
<!-- Uma linha de "Por tratar": ícone, texto e seta; toca e abre o ecrã certo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/if_card_padding"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/icone"
        android:layout_width="@dimen/if_icon"
        android:layout_height="@dimen/if_icon"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/texto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.FinsaFix.Body"
        android:textColor="@color/if_on_surface" />

    <ImageView
        android:layout_width="@dimen/if_icon"
        android:layout_height="@dimen/if_icon"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chev"
        app:tint="@color/if_on_surface_variant" />
</LinearLayout>
