<?xml version="1.0" encoding="utf-8"?>
<!-- "Quem está ao serviço?" com a lista das pessoas do posto. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/if_card_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/entrada_quem_esta"
        android:textAppearance="@style/TextAppearance.FinsaFix.HeadlineSmall"
        android:textColor="@color/if_on_surface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/entrada_toque_no_nome"
        android:textAppearance="@style/TextAppearance.FinsaFix.Body"
        android:textColor="@color/if_on_surface_variant" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaPessoas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/if_item_gap"
        android:nestedScrollingEnabled="false"
        android:orientation="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/if_item_gap"
        android:text="@string/entrada_cracha_texto"
        android:textAppearance="@style/TextAppearance.FinsaFix.Body"
        android:textColor="@color/if_on_surface_variant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoCracha"
        style="@style/Widget.FinsaFix.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/entrada_cracha_botao"
        app:icon="@drawable/ic_nfc" />

    <!-- Só no telemóvel: a entrada não tem menu em baixo, por isso o “Mais” (modo escuro, emergência, configurar posto) fica aqui. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoMaisEntrada"
        style="@style/Widget.FinsaFix.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/menu_mais"
        android:textColor="@color/if_on_surface_variant"
        android:visibility="gone"
        app:icon="@drawable/ic_menu"
        app:iconTint="@color/if_on_surface_variant" />

    <TextView
        android:id="@+id/textoSemPessoas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/if_item_gap"
        android:text="@string/entrada_a_carregar"
        android:textAppearance="@style/TextAppearance.FinsaFix.Body"
        android:textColor="@color/if_on_surface_variant"
        android:visibility="gone" />
</LinearLayout>
