<?xml version="1.0" encoding="utf-8"?>
<!-- Um número principal da pré-visualização (nome pequeno, valor em destaque); mete-se numa GridLayout de 2 colunas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:orientation="vertical"
    android:paddingBottom="@dimen/if_item_gap">

    <TextView
        android:id="@+id/nome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.FinsaFix.Secondary"
        android:textColor="@color/if_on_surface_variant" />

    <TextView
        android:id="@+id/valor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.FinsaFix.Value"
        android:textColor="@color/if_on_surface" />
</LinearLayout>
