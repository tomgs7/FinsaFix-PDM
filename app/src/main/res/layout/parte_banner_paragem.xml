<?xml version="1.0" encoding="utf-8"?>
<!-- Banner vermelho da paragem ativa (Início do operador e Oficina do chefe de oficina). Duas colunas no tablet: ver BannerParagem. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/if_error">

    <!-- Duas colunas no tablet (texto à esquerda, cronómetro e botão à direita): a orientação é posta no código -->
    <LinearLayout
        android:id="@+id/corpoParagem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/if_card_padding">

        <LinearLayout
            android:id="@+id/colunaParagemTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:id="@+id/textoParagemTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_stop_x"
            android:drawablePadding="6dp"
            android:drawableTint="@color/if_on_error"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body"
            android:textColor="@color/if_on_error" />

        <TextView
            android:id="@+id/textoParagemEquipamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FinsaFix.Headline"
            android:textColor="@color/if_on_error" />

        <TextView
            android:id="@+id/textoParagemDesde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body"
            android:textColor="@color/if_on_error" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/colunaParagemTempo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_item_gap"
            android:text="@string/banner_tempo_parado"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body"
            android:textColor="@color/if_on_error" />

        <!-- Chronometer: o Android conta o tempo sozinho a partir de "base". -->
        <Chronometer
            android:id="@+id/cronometroParagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FinsaFix.Display"
            android:textColor="@color/if_on_error" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoParagem"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_item_gap"
            android:minHeight="@dimen/if_btn_height"
            android:textAppearance="@style/TextAppearance.FinsaFix.Label"
            android:textColor="@color/if_on_error"
            app:icon="@drawable/ic_chev"
            app:iconGravity="end"
            app:iconTint="@color/if_on_error"
            app:strokeColor="@color/if_on_error" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
