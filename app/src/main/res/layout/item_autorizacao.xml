<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="@dimen/if_touch_min"
    android:orientation="vertical"
    android:padding="@dimen/if_card_padding">

    <TextView
        android:id="@+id/textoTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        android:drawableTint="@color/if_on_surface_variant"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.FinsaFix.Title" />

    <TextView
        android:id="@+id/textoPedido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.FinsaFix.Body"
        android:textColor="@color/if_on_surface_variant" />

    <TextView
        android:id="@+id/textoEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.FinsaFix.Body" />
</LinearLayout>
