<?xml version="1.0" encoding="utf-8"?>
<!-- Pedir autorização de trabalho: tipo (cartões com legenda), equipamento, o que vai fazer e duração. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/textoEquipamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_factory"
            android:drawablePadding="6dp"
            android:drawableTint="@color/if_on_surface_variant"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body"
            android:textColor="@color/if_on_surface_variant" />

        <!-- Um ou mais tipos de trabalho (caixas de seleção criadas pelo código) -->
        <LinearLayout
            android:id="@+id/grupoTipos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_item_gap"
            android:orientation="vertical" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoDescricao"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_item_gap"
            android:hint="@string/aut_descricao_dica"
            app:counterEnabled="true"
            app:counterMaxLength="300">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:textAppearance="@style/TextAppearance.FinsaFix.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/FinsaFix.TituloSeccao"
            android:layout_marginTop="@dimen/if_item_gap"
            android:text="@string/aut_duracao" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoDuracao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip30"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aut_duracao_30" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip60"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/aut_duracao_60" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip120"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aut_duracao_120" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTurno"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aut_duracao_turno" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
