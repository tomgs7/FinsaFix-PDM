<?xml version="1.0" encoding="utf-8"?>
<!-- Registar paragem: “Porque parou?” com o equipamento e uma das causas, numa janela (tablet) ou folha (telemóvel). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/paragem_porque"
        android:textAppearance="@style/TextAppearance.FinsaFix.Headline"
        android:textColor="@color/if_on_surface" />

    <!-- 0 dp com peso: se o conteúdo for alto, esta zona rola e os botões ficam sempre à vista -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                style="@style/FinsaFix.TituloSeccao"
                android:layout_marginTop="@dimen/if_item_gap"
                android:text="@string/paragens_escolher_equipamento" />

            <RadioGroup
                android:id="@+id/grupoEquipamentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/FinsaFix.TituloSeccao"
                android:layout_marginTop="@dimen/if_item_gap"
                android:text="@string/paragens_escolher_causa" />

            <RadioGroup
                android:id="@+id/grupoCausas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/if_item_gap"
                android:drawableStart="@drawable/ic_info"
                android:drawablePadding="6dp"
                android:drawableTint="@color/if_on_surface_variant"
                android:gravity="center_vertical"
                android:text="@string/paragem_aviso_avaria"
                android:textAppearance="@style/TextAppearance.FinsaFix.Body"
                android:textColor="@color/if_on_surface_variant" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="@dimen/if_item_gap">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoCancelar"
            style="@style/Widget.FinsaFix.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/if_item_gap"
            android:layout_weight="1"
            android:minHeight="@dimen/if_btn_main_height"
            android:text="@string/botao_cancelar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoIniciar"
            style="@style/Widget.FinsaFix.Button.Main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/paragem_iniciar"
            app:icon="@drawable/ic_pause" />
    </LinearLayout>
</LinearLayout>
