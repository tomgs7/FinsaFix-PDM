<?xml version="1.0" encoding="utf-8"?>
<!-- Teclado numérico: valor em cima, informação (limite/estado), erro e 12 teclas em 3 colunas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/if_numfield_height"
        android:background="@drawable/fundo_campo_valor"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/textoValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/valor_vazio"
            android:textAppearance="@style/TextAppearance.FinsaFix.Value"
            android:textColor="@color/if_on_surface" />

        <TextView
            android:id="@+id/textoUnidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body"
            android:textColor="@color/if_on_surface_variant" />
    </LinearLayout>

    <TextView
        android:id="@+id/textoInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.FinsaFix.Body"
        android:textColor="@color/if_on_surface_variant" />

    <TextView
        android:id="@+id/textoErro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/erro_valor_vazio"
        android:textAppearance="@style/TextAppearance.FinsaFix.Body"
        android:textColor="@color/if_error_text"
        android:visibility="gone" />

    <GridLayout
        android:id="@+id/grelhaTeclas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/if_item_gap"
        android:columnCount="3" />
</LinearLayout>
