<?xml version="1.0" encoding="utf-8"?>
<!-- A lista é o conteúdo principal, por isso a RecyclerView faz o próprio scroll. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/margem_ecra">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoRegistar"
        style="@style/Widget.FinsaFix.Button.Main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/if_section_gap"
        android:text="@string/paragens_registar"
        app:icon="@drawable/ic_pause"
        app:iconGravity="textStart" />

    <TextView
        android:id="@+id/textoKpis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textAppearance="@style/TextAppearance.FinsaFix.Body"
        android:textColor="@color/if_on_surface_variant" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/paragens_subtitulo"
        android:textAppearance="@style/TextAppearance.FinsaFix.Title"
        android:textColor="@color/if_on_surface" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaParagens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <TextView
                android:id="@+id/textoVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/if_card_padding"
                android:text="@string/paragens_vazio"
                android:textAppearance="@style/TextAppearance.FinsaFix.Body"
                android:textColor="@color/if_on_surface_variant"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
