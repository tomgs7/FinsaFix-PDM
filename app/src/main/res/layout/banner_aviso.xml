<?xml version="1.0" encoding="utf-8"?>
<!-- Banner de aviso urgente, por baixo da barra de topo de todos os ecrãs. As cores são definidas no código (BannerAviso.kt). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margem_ecra"
    android:layout_marginTop="8dp"
    android:visibility="gone"
    app:cardBackgroundColor="@color/if_error">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.FinsaFix.Title" />

        <TextView
            android:id="@+id/detalhe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="@dimen/if_btn_height"
            android:textAppearance="@style/TextAppearance.FinsaFix.Label" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
