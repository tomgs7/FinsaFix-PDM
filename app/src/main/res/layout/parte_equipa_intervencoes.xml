<?xml version="1.0" encoding="utf-8"?>
<!-- Equipa (chefe de oficina): "Intervenções em curso", um cartão por avaria (preenchidos no código). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/FinsaFix.TituloSeccao"
        android:text="@string/equipa_intervencoes_titulo" />

    <LinearLayout
        android:id="@+id/listaIntervencoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/textoSemIntervencoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/if_card_padding"
        android:text="@string/equipa_sem_intervencoes"
        android:textAppearance="@style/TextAppearance.FinsaFix.Body"
        android:textColor="@color/if_on_surface_variant"
        android:visibility="gone" />
</LinearLayout>
