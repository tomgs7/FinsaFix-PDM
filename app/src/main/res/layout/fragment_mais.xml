<?xml version="1.0" encoding="utf-8"?>
<!-- Janela "Mais" (bottom sheet): conta, itens do menu que não cabem, modo escuro, ajuda, posto e terminar turno. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_ecra">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_mais"
            android:textAppearance="@style/TextAppearance.FinsaFix.Title"
            android:textColor="@color/if_on_surface" />

        <LinearLayout
            android:id="@+id/cabecalhoPessoa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_item_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/fundo_avatar"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.FinsaFix.Title"
                android:textColor="@color/if_on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Title"
                    android:textColor="@color/if_on_surface" />

                <TextView
                    android:id="@+id/funcao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Body"
                    android:textColor="@color/if_on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Itens do menu que não cabem na barra (preenchido pelo código) -->
        <LinearLayout
            android:id="@+id/listaExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_item_gap"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_item_gap"
            android:gravity="center_vertical"
            android:minHeight="@dimen/if_touch_min"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/if_card_padding">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mais_modo_escuro"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Body"
                    android:textColor="@color/if_on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mais_modo_escuro_sub"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Secondary"
                    android:textColor="@color/if_on_surface_variant" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/interruptorEscuro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listaAjuda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/textoEntrada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/if_card_padding"
            android:layout_marginTop="@dimen/if_item_gap"
            android:textAppearance="@style/TextAppearance.FinsaFix.Secondary"
            android:textColor="@color/if_on_surface_variant" />

        <LinearLayout
            android:id="@+id/listaPosto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoSair"
            style="@style/Widget.FinsaFix.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_item_gap"
            app:icon="@drawable/ic_logout" />

        <TextView
            android:id="@+id/textoSessao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.FinsaFix.Secondary"
            android:textColor="@color/if_on_surface_variant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_item_gap"
            android:drawableStart="@drawable/ic_check_circle"
            android:drawablePadding="8dp"
            android:drawableTint="@color/if_ok_text"
            android:gravity="center"
            android:text="@string/mais_quiosque"
            android:textAppearance="@style/TextAppearance.FinsaFix.Secondary"
            android:textColor="@color/if_on_surface_variant" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
