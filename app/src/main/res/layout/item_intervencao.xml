<?xml version="1.0" encoding="utf-8"?>
<!-- Um cartão da Equipa: a avaria em curso, a equipa (item_membro_equipa) e as últimas atualizações. Tocar abre o detalhe. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/if_item_gap"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/if_card_padding">

        <TextView
            android:id="@+id/textoCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FinsaFix.Secondary"
            android:textColor="@color/if_on_surface_variant" />

        <TextView
            android:id="@+id/textoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FinsaFix.Title"
            android:textColor="@color/if_on_surface" />

        <TextView
            android:id="@+id/textoLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body"
            android:textColor="@color/if_on_surface_variant" />

        <TextView
            android:id="@+id/textoDuracao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body"
            android:textColor="@color/if_warn_text" />

        <LinearLayout
            android:id="@+id/listaEquipa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_item_gap"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_item_gap"
            android:text="@string/equipa_ultimas_atualizacoes"
            android:textAppearance="@style/TextAppearance.FinsaFix.Label"
            android:textColor="@color/if_on_surface_variant" />

        <LinearLayout
            android:id="@+id/listaAtualizacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
