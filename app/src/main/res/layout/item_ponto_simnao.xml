<?xml version="1.0" encoding="utf-8"?>
<!-- Um ponto da checklist do chefe: o texto e “Sim / Não”. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/textoPonto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.FinsaFix.Body"
        android:textColor="@color/if_on_surface" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoSimNao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:singleSelection="true"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoSim"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/if_touch_min"
            android:text="@string/sim" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoNao"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/if_touch_min"
            android:text="@string/nao" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
