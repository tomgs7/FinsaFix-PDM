<?xml version="1.0" encoding="utf-8"?>
<!-- Engenharia: MTBF e MTTR por equipamento. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_ecra">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsPeriodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:checkedChip="@id/chip7dias"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip7dias"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/periodo_7"
                android:textAppearance="@style/TextAppearance.FinsaFix.Label" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip30dias"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/periodo_30"
                android:textAppearance="@style/TextAppearance.FinsaFix.Label" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoSecaoIndicadores"
            style="@style/Widget.FinsaFix.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_factory" />

        <TextView
            android:id="@+id/textoKpis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body"
            android:textColor="@color/if_on_surface" />

        <TextView
            style="@style/FinsaFix.TituloSeccao"
            android:layout_marginTop="@dimen/if_section_gap"
            android:text="@string/indicadores_grafico" />

        <pt.ubi.di.pdm.finsafix.ui.consulta.GraficoBarras
            android:id="@+id/grafico"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="@dimen/if_item_gap" />

        <TextView
            style="@style/FinsaFix.TituloSeccao"
            android:text="@string/indicadores_por_secao" />

        <TextView
            android:id="@+id/textoPorSecao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/if_item_gap"
            android:lineSpacingExtra="4dp"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body"
            android:textColor="@color/if_on_surface" />

        <TextView
            style="@style/FinsaFix.TituloSeccao"
            android:text="@string/indicadores_maquinas" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/if_item_gap"
            android:text="@string/indicadores_explicacao"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body"
            android:textColor="@color/if_on_surface_variant" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listaIndicadores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <TextView
                    android:id="@+id/textoSemIndicadores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/if_card_padding"
                    android:text="@string/indicadores_vazio"
                    android:textAppearance="@style/TextAppearance.FinsaFix.Body"
                    android:textColor="@color/if_on_surface_variant"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
