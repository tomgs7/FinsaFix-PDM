<?xml version="1.0" encoding="utf-8"?>
<!-- “Primeira vez no FinsaFix?”: aparece no início do operador e do técnico até tocarem em “Já sei usar”. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/if_section_gap"
    app:cardBackgroundColor="@color/if_secondary_container">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/if_card_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/primeira_vez_titulo"
            android:textAppearance="@style/TextAppearance.FinsaFix.Title"
            android:textColor="@color/if_on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/primeira_vez_texto"
            android:textAppearance="@style/TextAppearance.FinsaFix.Body"
            android:textColor="@color/if_on_surface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/if_item_gap"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoVerComoUsar"
                style="@style/Widget.FinsaFix.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/primeira_vez_ver" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoJaSei"
                style="@style/Widget.FinsaFix.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/primeira_vez_ja_sei" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
