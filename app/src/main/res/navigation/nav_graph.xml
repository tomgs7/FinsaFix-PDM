<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/entradaFragment">

    <!-- Terminar sessão: volta à entrada e limpa todo o histórico de ecrãs. -->
    <action
        android:id="@+id/acao_terminar_sessao"
        app:destination="@id/entradaFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <!-- Abrir o detalhe a partir de qualquer lista (Início, Avarias, Minhas, Histórico). -->
    <action
        android:id="@+id/acao_para_detalhe"
        app:destination="@id/detalheFragment" />

    <fragment
        android:id="@+id/entradaFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.entrada.EntradaFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/acao_entrada_para_inicio"
            app:destination="@id/inicioFragment"
            app:popUpTo="@id/entradaFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/acao_entrada_para_tecnico"
            app:destination="@id/avariasTecnicoFragment"
            app:popUpTo="@id/entradaFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/acao_entrada_para_seccao"
            app:destination="@id/seccaoFragment"
            app:popUpTo="@id/entradaFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/acao_entrada_para_engenharia"
            app:destination="@id/engenhariaInicioFragment"
            app:popUpTo="@id/entradaFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/acao_entrada_para_oficina"
            app:destination="@id/oficinaFragment"
            app:popUpTo="@id/entradaFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/pedidosFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.pedidos.PedidosFragment"
        android:label="@string/titulo_pedidos" />

    <fragment
        android:id="@+id/validarFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.autorizacoes.ValidarFragment"
        android:label="@string/titulo_validar" />

    <!-- Operador: Pedidos, Instruções e Turno (o Turno também é do técnico). -->
    <fragment
        android:id="@+id/pedidosOperadorFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.pedidos.PedidosOperadorFragment"
        android:label="@string/titulo_pedidos" />

    <fragment
        android:id="@+id/instrucoesFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.instrucoes.InstrucoesFragment"
        android:label="@string/titulo_instrucoes" />

    <fragment
        android:id="@+id/turnoFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.turno.TurnoFragment"
        android:label="@string/titulo_turno" />

    <!-- Engenharia e chefe de oficina (só consulta): o mesmo ecrã de números ("Início" / "Resumo") e de lista ("Avarias" / "Oficina"). -->
    <fragment
        android:id="@+id/engenhariaInicioFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.consulta.EngenhariaInicioFragment"
        android:label="@string/titulo_engenharia_inicio" />

    <fragment
        android:id="@+id/avariasFabricaFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.consulta.ConsultaFragment"
        android:label="@string/titulo_avarias_fabrica" />

    <fragment
        android:id="@+id/indicadoresFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.consulta.IndicadoresFragment"
        android:label="@string/titulo_indicadores" />

    <fragment
        android:id="@+id/oficinaFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.consulta.OficinaEstadoFragment"
        android:label="@string/titulo_estado_oficina" />

    <fragment
        android:id="@+id/equipaFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.consulta.EquipaOficinaFragment"
        android:label="@string/titulo_equipa" />

    <fragment
        android:id="@+id/oficinaResumoFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.consulta.ResumoOficinaFragment"
        android:label="@string/titulo_resumo" />

    <!-- Chefe de secção: "Secção" é o mesmo ecrã do Início do operador (a classe decide o que mostra pelo perfil). -->
    <fragment
        android:id="@+id/seccaoFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.inicio.InicioFragment"
        android:label="@string/titulo_estado_seccao">
        <action
            android:id="@+id/acao_inicio_para_paragens"
            app:destination="@id/paragensFragment" />
    </fragment>

    <fragment
        android:id="@+id/planoFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.resumo.PlanoFragment"
        android:label="@string/titulo_plano" />

    <fragment
        android:id="@+id/planosFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.consulta.PlanosFragment"
        android:label="@string/titulo_planos" />

    <fragment
        android:id="@+id/instrucoesEngFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.instrucoes.InstrucoesEngenhariaFragment"
        android:label="@string/titulo_instrucoes" />

    <fragment
        android:id="@+id/relatoriosFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.consulta.RelatoriosFragment"
        android:label="@string/titulo_relatorios" />

    <fragment
        android:id="@+id/distribuirFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.consulta.DistribuirFragment"
        android:label="@string/titulo_distribuir" />

    <fragment
        android:id="@+id/resumoChefeFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.resumo.ResumoChefeFragment"
        android:label="@string/titulo_resumo" />

    <!-- Operador -->
    <fragment
        android:id="@+id/inicioFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.inicio.InicioFragment"
        android:label="@string/titulo_inicio">
        <action
            android:id="@+id/acao_inicio_para_paragens"
            app:destination="@id/paragensFragment" />
    </fragment>

    <fragment
        android:id="@+id/checklistFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.parametros.ChecklistFragment"
        android:label="@string/titulo_checklist" />

    <fragment
        android:id="@+id/producaoFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.producao.ProducaoFragment"
        android:label="@string/titulo_producao" />

    <fragment
        android:id="@+id/parametrosFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.parametros.ParametrosFragment"
        android:label="@string/titulo_controlo" />

    <!-- Operador (a partir do Início) e técnico (menu) -->
    <fragment
        android:id="@+id/paragensFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.paragens.ParagensFragment"
        android:label="@string/titulo_paragens" />

    <!-- Técnico: o mesmo Fragment serve "Avarias" e "Minhas" (argumento apenasMinhas). -->
    <fragment
        android:id="@+id/avariasTecnicoFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.tecnico.TecnicoFragment"
        android:label="@string/titulo_avarias_oficina">
        <argument
            android:name="apenasMinhas"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/minhasFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.tecnico.TecnicoFragment"
        android:label="@string/titulo_minhas">
        <argument
            android:name="apenasMinhas"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

    <!-- Técnico: Preventiva, Rondas e Stock (o Turno é o mesmo do operador). -->
    <fragment
        android:id="@+id/preventivaFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.preventiva.PreventivaFragment"
        android:label="@string/titulo_preventiva" />

    <fragment
        android:id="@+id/rondasFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.rondas.RondasFragment"
        android:label="@string/titulo_rondas" />

    <fragment
        android:id="@+id/stockFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.stock.StockFragment"
        android:label="@string/titulo_stock" />

    <!-- Operador e técnico -->
    <fragment
        android:id="@+id/historicoFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.historico.HistoricoFragment"
        android:label="@string/titulo_historico" />

    <!-- O título da barra é o código da avaria (argumento "codigo"). -->
    <fragment
        android:id="@+id/detalheFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.detalhe.DetalheFragment"
        android:label="{codigo}">
        <argument
            android:name="avariaId"
            app:argType="long" />
        <argument
            android:name="codigo"
            app:argType="string" />
        <action
            android:id="@+id/acao_detalhe_para_progresso"
            app:destination="@id/progressoFragment" />
    </fragment>


    <fragment
        android:id="@+id/progressoFragment"
        android:name="pt.ubi.di.pdm.finsafix.ui.progresso.ProgressoFragment"
        android:label="@string/deixar_em_progresso">
        <argument
            android:name="avariaId"
            app:argType="long" />
    </fragment>
</navigation>
